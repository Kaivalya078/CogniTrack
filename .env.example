# Copy to .env (repo root) and fill in real values. .env is gitignored.

# Used by infra/docker-compose.yml to create the database
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
# Host port for the Docker Postgres. Use 5433 if a local Postgres already holds 5432.
POSTGRES_PORT=5432

# Used by the backend (FastAPI, Alembic, pytest). Must match the values above. 127.0.0.1, not
# localhost: compose publishes on IPv4 only, and the IPv6 attempt can hang on Windows.
DATABASE_URL=postgresql+psycopg://portfolio:change-me@127.0.0.1:5432/portfolio

# Host names the API answers to (JSON list); anything else is refused. On the VM, add its
# Tailscale names, e.g. ["cognitrack","cognitrack.tail1234.ts.net","localhost","127.0.0.1"].
# Keep localhost and 127.0.0.1: the container health check uses them.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Production (the VM) only; see docs/deploy.md ---
# On the VM, docker-compose.prod.yml builds the database URL from the POSTGRES_* values above,
# so the password must be letters and digits only: openssl rand -hex 24
# Loopback port the web container listens on; `tailscale serve` forwards the tailnet to it.
HTTP_PORT=8080
# Where infra/backup.sh uploads each night: a write-only Object Storage pre-authenticated
# request URL for the backup bucket, ending in /o/. Keep it secret: it allows writes.
BACKUP_UPLOAD_URL=
